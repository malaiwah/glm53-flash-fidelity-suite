#!/usr/bin/env bash
# Check a sealed receipt the way the registry will, before you send it anywhere.
#
#   bin/registry-submit <out>/receipts/measurement-receipt.json
#
# The file both runners seal -- measurement-receipt.json -- IS your submission
# receipt; this command validates that one file. Prints the row it would
# generate, its comparability key and class, and the rows it can be ranked
# against -- or exactly which check it failed. Offline; no installs, no
# network, nothing published.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
case "${1:-}" in
  -h|--help|"")
    echo "usage: bin/registry-submit <receipt.json>"
    echo
    echo "Validates a sealed measurement-receipt.json exactly as the registry will"
    echo "(offline; nothing is published) and prints the row it would generate."
    echo "The candidate route's comparison-receipt.json is not a submission receipt;"
    echo "see docs/THIRD-PARTY-QUICKSTART.md section 5."
    [ -n "${1:-}" ] && exit 0
    exit 2
    ;;
esac
RECEIPT="$1"
PY="${FIDELITY_PYTHON:-python3}"
"$PY" "$ROOT/registry/tools/registry_validate.py" --submission "$RECEIPT"
echo
echo "If that said ACCEPTED, this file is your submission receipt -- submit it"
echo "as-is (see registry/CONTRIBUTING.md; step-by-step: docs/THIRD-PARTY-QUICKSTART.md):"
echo "  live path  open a discussion on the registry dataset and attach this file"
echo "             https://huggingface.co/datasets/malaiwah/quant-fidelity-registry/discussions"
echo "  (the GitHub PR mirror described in CONTRIBUTING §3 is NOT live yet)"
