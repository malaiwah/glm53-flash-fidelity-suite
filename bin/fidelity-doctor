#!/usr/bin/env python3
"""fidelity-doctor -- is THIS machine ready to run a measurement? One command.

    bin/fidelity-doctor

Read-only and offline. It never prints a secret: credentials are reported as
present/absent with their path, never their value. This is a local prerequisite
check, not paid authorization. The exact `measure-cloud --dry-run` revalidates
the provider account, current inventory/balance, reaper health, drill proof,
campaign ledger and scientific target.

The heavier verifications stay where they are:
`bin/measure-local --selftest`, `bin/measure-local --probe-engines`,
`bash bin/selftest_all.sh`, and the exact commands in
`docs/THIRD-PARTY-QUICKSTART.md`.

Exit 0 means the stock local tooling is usable. Warnings name missing paid or
local-execution prerequisites. A paid run is authorized only by all executable
pre-POST gates in `measure-cloud`.
"""

import os
import subprocess
import sys
from pathlib import Path

SUITE_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SUITE_ROOT / "bin"))

hard_failures = []
warnings = []


def ok(name, detail=""):
    print("  OK    %-34s %s" % (name, detail))


def warn(name, detail, remedy):
    print("  WARN  %-34s %s" % (name, detail))
    print("        remedy: %s" % remedy)
    warnings.append(name)


def fail(name, detail, remedy):
    print("  FAIL  %-34s %s" % (name, detail))
    print("        remedy: %s" % remedy)
    hard_failures.append(name)


def main():
    print("fidelity-doctor  (read-only; no network calls; no secret is printed)")
    print()

    # -- interpreter (bin/ and registry/ run on stock python3.9+) ----------
    v = sys.version_info
    if (v.major, v.minor) >= (3, 9):
        ok("python", "%d.%d.%d at %s" % (v.major, v.minor, v.micro, sys.executable))
    else:
        fail("python", "%d.%d < 3.9" % (v.major, v.minor),
             "bin/ tools need python >= 3.9 (stock, no pip installs)")

    # -- suite entrypoints -------------------------------------------------
    missing = [t for t in ("measure", "measure-local", "measure-cloud",
                           "registry-submit", "registry-view")
               if not os.access(str(SUITE_ROOT / "bin" / t), os.X_OK)]
    if not missing:
        ok("suite entrypoints", "measure / measure-local / measure-cloud / "
                                "registry-submit / registry-view")
    else:
        fail("suite entrypoints", "not executable: %s" % ", ".join(missing),
             "clone the suite repo intact; chmod +x bin/*")

    # -- engine pins -------------------------------------------------------
    try:
        from fidelity.engines import load_engines
        engines = load_engines()
        unpinned = sorted(l for l, e in engines.items() if not e.pinned)
        if not unpinned:
            ok("engine pins", "%d lanes, all pinned (deep check: "
                              "bin/measure-local --probe-engines)" % len(engines))
        else:
            fail("engine pins", "unpinned lanes: %s" % ", ".join(unpinned),
                 "an unpinned lane refuses to plan; see bin/engines.json")
    except Exception as exc:                                  # noqa: BLE001
        fail("engine pins", "cannot load bin/engines.json: %s" % exc,
             "restore bin/engines.json from the repo")

    # -- registry (offline clone fallback) ---------------------------------
    data = SUITE_ROOT / "registry" / "data" / "measurements.jsonl"
    if data.is_file():
        ok("registry clone", "local data present (runners also try the "
                             "public HF dataset first)")
    else:
        warn("registry clone", "registry/data/measurements.jsonl not found",
             "clone the full suite repo; the runners can still use the "
             "public HF dataset when the network is up")

    # -- HF auth (controller-local publication and gated local work only) ---
    from fidelity.hfmeta import hf_token
    tok = hf_token()   # registers redaction; NEVER printed
    if tok:
        src = ("env HF_TOKEN/HUGGING_FACE_HUB_TOKEN"
               if (os.environ.get("HF_TOKEN")
                   or os.environ.get("HUGGING_FACE_HUB_TOKEN"))
               else "cached login (~/.cache/huggingface/token)")
        ok("hugging face auth", "optional token found via %s "
                                "(value not shown)" % src)
    else:
        ok("hugging face auth", "absent; admitted paid artifacts must be "
                                "anonymous on official HF")

    # -- sole admitted paid provider credential ----------------------------
    try:
        from fidelity.runpodapi import DEFAULT_KEY_FILE, RunPod
        key_path = str(Path(
            os.environ.get("RUNPOD_KEY_FILE") or DEFAULT_KEY_FILE
        ).expanduser().resolve())
        runpod_available = RunPod(key_file=key_path).available()
    except Exception:                                         # noqa: BLE001
        key_path = str(Path.home() / ".config" / "runpod" / "api_key")
        runpod_available = False
    if runpod_available:
        ok("runpod credential", "owner mode-0600 key file present at %s"
                                % key_path)
    else:
        warn("runpod credential", "no usable owner mode-0600 key file at %s"
             % key_path,
             "write the RunPod key to that absolute path; never put key bytes "
             "in argv or an environment value")

    # -- SSH key -----------------------------------------------------------
    pub = Path.home() / ".ssh" / "id_ed25519.pub"
    if pub.is_file():
        ok("ssh public key", str(pub))
    else:
        warn("ssh public key", "~/.ssh/id_ed25519.pub not found",
             "ssh-keygen -t ed25519; the paid route authenticates each pod "
             "automatically through RunPod's bounded v2 container-log API")

    # -- account-bound systemd reaper and paid drill state -----------------
    state = Path.home() / ".fidelity-cloud"
    control = state / "reaper-control.json"
    health = state / "reaper-health.json"
    if control.is_file() and health.is_file():
        ok("runpod reaper state", "control and health artifacts present; "
                                  "measure-cloud revalidates timer, account, "
                                  "paths, digests and freshness")
    else:
        warn("runpod reaper state", "canonical control/health artifacts absent",
             "install with the exact RunPod command in "
             "docs/THIRD-PARTY-QUICKSTART.md §3")

    proof = state / "drill" / "proof.json"
    if proof.is_file():
        ok("controller-loss proof", "artifact present; measure-cloud validates "
                                    "its account, checkout, age and billing")
    else:
        warn("controller-loss proof", "no canonical paid drill proof",
             "run the spend-free drill dry-run, then the explicitly authorized "
             "paid drill in docs/THIRD-PARTY-QUICKSTART.md §4")

    # -- FIDELITY_PYTHON (local execute / preview scoring only) ------------
    fpy = os.environ.get("FIDELITY_PYTHON")
    if fpy:
        try:
            torch_ok = subprocess.run(
                [fpy, "-c", "import torch"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=30).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            torch_ok = False
        if torch_ok:
            ok("local torch env", "FIDELITY_PYTHON=%s imports torch" % fpy)
        else:
            warn("local torch env", "FIDELITY_PYTHON=%s cannot import torch" % fpy,
                 "python3 -m venv ~/.venvs/fidelity && ~/.venvs/fidelity/bin/pip "
                 "install torch safetensors numpy huggingface_hub")
    else:
        warn("local torch env", "FIDELITY_PYTHON not set (only needed for "
             "measure-local --execute and preview scoring; the CLOUD recipe "
             "does not need torch on this machine)",
             "python3 -m venv ~/.venvs/fidelity; pip install torch "
             "safetensors numpy huggingface_hub; export "
             "FIDELITY_PYTHON=~/.venvs/fidelity/bin/python3")

    if hard_failures:
        print("NOT READY: %d hard failure(s): %s"
              % (len(hard_failures), ", ".join(hard_failures)))
        return 1
    if warnings:
        print("LOCAL CHECKS COMPLETE; %d warning(s) above name missing paid "
              "or local-execution prerequisites." % len(warnings))
    else:
        print("LOCAL PREREQUISITES PRESENT. This is not paid GO; run the exact "
              "supported --dry-run next.")
    print("next: docs/THIRD-PARTY-QUICKSTART.md §5")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
