# Runner output directories. measure_cloud.py writes the HF token to
# fidelity-runs/<job>/.hf_token for the seconds it takes to upload it; a crash
# in that window would otherwise leave a live token inside the repo, where
# `git add -A` stages it and `git status` (which collapses the untracked dir)
# does not show it.
fidelity-runs/
fidelity-local/

# arch-determinism probe tensor dumps: ~84 MB per card, and the digests in
# each rental.json already cover them. Re-run the probe to regenerate.
reports/arch-determinism/results*/**/probe-tensors.npz
